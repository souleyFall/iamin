// Schéma de la base d'i-am-in. Les modèles arrivent avec les PR qui en ont besoin
// (comptes et sessions : PR 6 ; groupes : PR 7 ; tournois : PR 8, etc.).
// Chaque changement passe par une migration versionnée dans `prisma/migrations`.

generator client {
  // Le client est généré dans node_modules (`pnpm generate`, lancé à l'installation) :
  // jamais versionné, et chargé par `@prisma/client` aussi bien en développement qu'en production.
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Rôle sur la plateforme. Le rôle dans un groupe est porté par GroupMember : un compte peut
/// appartenir à plusieurs groupes, avec un rôle différent dans chacun.
enum Role {
  PLATFORM_OWNER // le propriétaire de la plateforme : valide les super admins, traite les tickets
  GROUP_CREATOR // « super admin » : invité par le propriétaire, seul à pouvoir créer des groupes
  MEMBER // tout autre compte : ses droits viennent de ses appartenances à des groupes
}

enum GroupRole {
  SUPER_ADMIN // créateur du groupe : invite ses admins, peut reprendre le relais
  ADMIN // admin du groupe
}

enum ResetTicketStatus {
  OPEN // demande reçue, en attente du propriétaire
  ISSUED // le propriétaire a émis un jeton à usage unique
  USED // mot de passe changé
  CLOSED // clos sans suite par le propriétaire
}

model User {
  id                String   @id @default(uuid()) @db.Uuid
  /// Identifiant de connexion, toujours en minuscules.
  username          String   @unique
  /// Pseudo Plato : sert au propriétaire à vérifier l'identité lors d'une réinitialisation.
  platoUsername     String
  /// Empreinte argon2id : jamais le mot de passe.
  passwordHash      String
  role              Role
  createdAt         DateTime @default(now())
  passwordChangedAt DateTime @default(now())

  sessions           Session[]
  resetTickets       ResetTicket[]
  memberships        GroupMember[]
  invitationsCreated Invitation[]      @relation("InvitationCreator")
  invitationsUsed    Invitation[]      @relation("InvitationUser")
  tournamentsHeld    Tournament[]      @relation("TournamentHolder")
  handoversOffered   Tournament[]      @relation("TournamentHandover")
  events             TournamentEvent[]
}

model Group {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())

  members     GroupMember[]
  invitations Invitation[]
  tournaments Tournament[]
}

enum TournamentFormat {
  ELIMINATION // élimination directe
  LEAGUE // tournoi à la ronde
}

enum TournamentStatus {
  REGISTRATION // inscriptions ouvertes
  CHECK_IN // pointage : inscriptions closes, les admins notent présents et absents
  STARTED // tirage fait : les inscriptions et le pointage sont figés, on saisit les scores
  FINISHED // champion connu (élimination) ou tous les matchs joués (ligue)
}

enum RegistrationStatus {
  PENDING // inscrit via le lien public, en attente de validation par un admin
  ACCEPTED // validé et dans la limite de places
  WAITLIST // validé, mais tournoi complet : passe en ACCEPTED dès qu'une place se libère
  REPLACED // remplacé après le tirage : la ligne reste pour l'historique des matchs
}

enum Side {
  A
  B
}

enum Presence {
  UNKNOWN
  PRESENT
  ABSENT
}

/// Un tournoi appartient à un seul groupe : toute lecture ou écriture est filtrée par groupId.
model Tournament {
  id           String           @id @default(uuid()) @db.Uuid
  groupId      String           @db.Uuid
  group        Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name         String
  format       TournamentFormat
  /// Nombre de places ; les validés au-delà vont en liste d'attente.
  capacity     Int
  status       TournamentStatus @default(REGISTRATION)
  /// Identifiant du lien public d'inscription (aléatoire, 128 bits). Il ne donne que le droit de
  /// s'inscrire et de voir le nom du tournoi.
  publicSlug   String           @unique
  createdAt    DateTime         @default(now())
  /// Points du vainqueur quand l'adversaire déclare forfait (le forfait perd 0).
  forfeitScore Int              @default(1)

  /// Tirage (vide avant le tirage). La graine est aléatoire, choisie par le serveur et publiée :
  /// avec `drawPlayers` (identifiants triés) n'importe qui peut refaire le tirage et comparer.
  drawSeed    String?
  drawPlayers String[]
  /// Nombre d'aller-retours d'une ligue (1 ou 2) ; vide pour une élimination directe.
  drawLegs    Int?
  /// Tableau ou calendrier calculé par le moteur, avec les remplacements appliqués depuis.
  structure   Json?
  drawnAt     DateTime?

  /// Celui qui « tient la main » : lui seul écrit (D5). `null` : personne, n'importe quel admin du
  /// groupe peut la prendre. Si le détenteur quitte le groupe ou est supprimé, elle se libère.
  holderId     String? @db.Uuid
  holder       User?   @relation("TournamentHolder", fields: [holderId], references: [id], onDelete: SetNull)
  /// Admin à qui le détenteur propose de passer le relais ; il doit l'accepter.
  handoverToId String? @db.Uuid
  handoverTo   User?   @relation("TournamentHandover", fields: [handoverToId], references: [id], onDelete: SetNull)

  registrations Registration[]
  results       MatchResult[]
  events        TournamentEvent[]

  @@index([groupId])
}

/// Inscription d'un joueur (sans compte). Retirer un joueur supprime la ligne : minimisation.
model Registration {
  id           String             @id @default(uuid()) @db.Uuid
  tournamentId String             @db.Uuid
  tournament   Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  /// Pseudo Plato tel que saisi (affiché, copié dans le chat).
  platoName    String
  /// Même pseudo en minuscules : un pseudo ne s'inscrit qu'une fois par tournoi.
  platoKey     String
  status       RegistrationStatus
  presence     Presence           @default(UNKNOWN)
  /// SHA-256 du lien personnel du joueur (suivi et annulation). Absent si un admin l'a inscrit.
  tokenHash    String?            @unique
  createdAt    DateTime           @default(now())
  /// Date de validation : fixe l'ordre de la liste d'attente.
  validatedAt  DateTime?

  @@unique([tournamentId, platoKey])
  @@index([tournamentId, status])
}

/// Appartenance d'un compte à un groupe. C'est la seule source des droits sur les données d'un
/// groupe : toute route qui lit ou écrit des données d'un groupe passe par elle (GroupGuard).
model GroupMember {
  id        String    @id @default(uuid()) @db.Uuid
  groupId   String    @db.Uuid
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      GroupRole
  createdAt DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  /// SHA-256 du jeton du cookie : une fuite de la base ne donne pas de session utilisable.
  tokenHash  String   @unique
  /// Jeton anti-CSRF propre à cette session.
  csrfToken  String
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
}

model Invitation {
  id            String     @id @default(uuid()) @db.Uuid
  /// SHA-256 du jeton du lien d'invitation. Le jeton lui-même n'est montré qu'une fois.
  tokenHash     String     @unique
  /// Groupe que la personne invitée rejoint, et rôle qu'elle y recevra. Les deux sont absents
  /// ensemble pour l'invitation d'un super admin (GROUP_CREATOR) faite par le propriétaire
  /// (contrainte CHECK dans la migration).
  groupId       String?    @db.Uuid
  group         Group?     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupRole     GroupRole?
  /// Pseudo Plato attendu : imposé à la création du compte (ou comparé à celui du compte connecté).
  /// Obligatoire pour un super admin, facultatif pour un admin.
  platoUsername String?
  createdById   String     @db.Uuid
  createdBy     User       @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  expiresAt     DateTime
  usedAt        DateTime?
  usedById      String?    @db.Uuid
  usedBy        User?      @relation("InvitationUser", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([groupId])
}

model ResetTicket {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @db.Uuid
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    ResetTicketStatus @default(OPEN)
  createdAt DateTime          @default(now())
  /// SHA-256 du jeton émis par le propriétaire (à usage unique, courte durée).
  tokenHash String?           @unique
  issuedAt  DateTime?
  expiresAt DateTime?
  closedAt  DateTime?

  @@index([userId])
  @@index([status])
}

/// Score d'un match (code du moteur : `R2M1`). Les joueurs viennent de `Tournament.structure`.
model MatchResult {
  id           String     @id @default(uuid()) @db.Uuid
  tournamentId String     @db.Uuid
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  code         String
  scoreA       Int
  scoreB       Int
  /// Camp qui a déclaré forfait (le score est alors celui des réglages du tournoi).
  forfeitBy    Side?
  /// Passe de 1 en 1 à chaque modification : un écran périmé ne peut pas écraser un score plus récent.
  version      Int        @default(1)
  updatedAt    DateTime   @updatedAt

  @@unique([tournamentId, code])
}

/// Journal : qui a fait quoi, quand (R14). Ajouté dans la même transaction que le changement.
/// La charge ne contient que des identifiants, des codes de match et des scores : jamais un pseudo
/// ni une donnée sensible, pour qu'effacer un joueur n'en laisse aucune trace ici.
model TournamentEvent {
  id           String     @id @default(uuid()) @db.Uuid
  tournamentId String     @db.Uuid
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  /// `null` pour une action d'un joueur sans compte, ou si le compte a été supprimé depuis.
  actorId      String?    @db.Uuid
  actor        User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type         String
  payload      Json
  createdAt    DateTime   @default(now())

  @@index([tournamentId, createdAt])
}
