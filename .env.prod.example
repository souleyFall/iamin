# Modèle du fichier .env.prod (production). Ce fichier-ci est versionné, sans aucun secret ;
# ton vrai .env.prod ne l'est jamais (voir .gitignore). Droits conseillés : chmod 600 .env.prod

# Nom de domaine du site, sans « https:// » ni « / ». Il doit déjà pointer vers ce serveur
# (enregistrement DNS A/AAAA) et les ports 80 et 443 doivent être ouverts : Caddy obtient alors
# seul le certificat HTTPS. Pour un essai local : localhost (certificat interne, non reconnu).
SITE_ADDRESS=

# Base de données. Génère le mot de passe avec : openssl rand -hex 24
# (des caractères hexadécimaux seulement : il est recopié dans une URL de connexion).
POSTGRES_USER=iamin
POSTGRES_PASSWORD=
POSTGRES_DB=iamin
