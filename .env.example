# Modèle du fichier .env : il liste les variables attendues, sans aucun secret.
# Ce fichier-ci est versionné ; ton vrai .env ne l'est jamais.

# --- Base de données : lues par docker-compose pour créer le conteneur PostgreSQL ---
POSTGRES_USER=iamin
POSTGRES_PASSWORD=
POSTGRES_DB=iamin
# Port exposé sur ta machine (127.0.0.1 uniquement). Change-le si 5432 est déjà pris.
POSTGRES_PORT=5432

# --- Base de données : lue par l'application pour s'y connecter ---
# Même mot de passe et même port que ci-dessus.
# 127.0.0.1 et non « localhost » : le conteneur n'écoute qu'en IPv4. Avec « localhost », certaines
# machines (Windows + Docker) tentent d'abord l'IPv6 et mettent plus de 2 s à ouvrir chaque
# nouvelle connexion, ce qui fait échouer les transactions simultanées (erreur Prisma P2028).
DATABASE_URL=postgresql://iamin:MOT_DE_PASSE@127.0.0.1:5432/iamin

# --- Tests d'intégration (facultatif en local, toujours défini en CI) ---
# Base dédiée dont le nom finit par _test : les tests y vident les tables.
# TEST_DATABASE_URL=postgresql://iamin:MOT_DE_PASSE@127.0.0.1:5432/iamin_test

# --- API ---
# development | test | production
NODE_ENV=development
PORT=3000
# Origine autorisée pour les appels de l'interface (CORS strict)
WEB_ORIGIN=http://localhost:5173
# Cookie de session « Secure » : vrai en production (HTTPS), faux en local
SESSION_COOKIE_SECURE=false

# Clé de chiffrement des secrets de double authentification (64 caractères hexadécimaux).
# Facultative en développement (une clé publique de repli sert) ; obligatoire en production.
# TOTP_ENCRYPTION_KEY=

# Journal de l'API : debug, info (défaut), warn, error ou silent.
# LOG_LEVEL=info
