# Modèle du fichier .env : il liste les variables attendues, sans aucun secret.
# Ce fichier-ci est versionné ; ton vrai .env ne l'est jamais.

# --- Base de données : lues par docker-compose pour créer le conteneur PostgreSQL ---
POSTGRES_USER=iamin
POSTGRES_PASSWORD=
POSTGRES_DB=iamin

# --- Base de données : lue par l'application pour s'y connecter ---
DATABASE_URL=postgresql://iamin:MOT_DE_PASSE@localhost:5432/iamin

# --- API ---
# development | test | production
NODE_ENV=development
PORT=3000
# Origine autorisée pour les appels de l'interface (CORS strict)
WEB_ORIGIN=http://localhost:5173
# Cookie de session « Secure » : vrai en production (HTTPS), faux en local
SESSION_COOKIE_SECURE=false
